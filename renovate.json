{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update actionlint and its image digest as one pair.",
      "managerFilePatterns": ["/^tools/tool-versions\\.env$/"],
      "matchStrings": [
        "ACTIONLINT_VERSION=(?<currentValue>[^\\s]+)\\nACTIONLINT_IMAGE_DIGEST=(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "rhysd/actionlint",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "ACTIONLINT_VERSION={{{newValue}}}\\nACTIONLINT_IMAGE_DIGEST={{{newDigest}}}"
    },
    {
      "customType": "regex",
      "description": "Update zizmor and its image digest as one pair.",
      "managerFilePatterns": ["/^tools/tool-versions\\.env$/"],
      "matchStrings": [
        "ZIZMOR_VERSION=(?<currentValue>[^\\s]+)\\nZIZMOR_IMAGE_DIGEST=(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/zizmorcore/zizmor",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "ZIZMOR_VERSION={{{newValue}}}\\nZIZMOR_IMAGE_DIGEST={{{newDigest}}}"
    }
  ],
  "gomod": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Auto-merge low-risk updates once required checks pass.",
      "matchUpdateTypes": ["pin", "pinDigest", "digest", "patch", "minor"],
      "automerge": true,
      "automergeStrategy": "squash",
      "platformAutomerge": false
    },
    {
      "description": "Group all GitHub Actions bumps into a single PR.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Major bumps require review.",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "breaking-change"],
      "automerge": false
    }
  ]
}
