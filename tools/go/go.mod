// Formatters plus security and release audit tools, pinned here instead of @latest so that
// tools resolve identical versions in CI and locally, and the update bot moves
// them. Kept out of the library modules so consumers never see these dependencies.
module github.com/golusoris/goenvoy/tools/go

go 1.26.10

tool (
	github.com/daixiang0/gci
	github.com/securego/gosec/v2/cmd/gosec
	github.com/segmentio/golines
	golang.org/x/exp/cmd/apidiff
	golang.org/x/vuln/cmd/govulncheck
	mvdan.cc/gofumpt
)

require go.yaml.in/yaml/v3 v3.0.5

